# انسخ هاد الملف باسم .env وعبّي القيم تبعتك (ما تشاركه مع حدا، فيه سر البوت)

# التوكن يلي أخدتو من @BotFather (أمر /newbot أو التوكن القديم تبع ALHARAM TOBACCO)
BOT_TOKEN=REPLACE_ME

# آيدي شات التاجر (المالك) يلي رح توصلو كل الإشعارات
# اعرفو بإرسال /start لبوت @userinfobot من حساب التاجر تلغرام
ADMIN_CHAT_ID=REPLACE_ME

# اسم المحل (بيظهر برسالة الترحيب)
SHOP_NAME=[اسم المحل]

# رقم واسم صاحب حساب شام كاش (لمسارات الدفع المسبق والعربون)
PAYMENT_SHAMCASH_NUMBER=REPLACE_ME
PAYMENT_SHAMCASH_NAME=REPLACE_ME

# رقم واسم صاحب حساب سيريتل كاش (لمسارات الدفع المسبق والعربون)
PAYMENT_SYRIATELCASH_NUMBER=REPLACE_ME
PAYMENT_SYRIATELCASH_NAME=REPLACE_ME

# ساعة بث نشرة الأسعار اليومية (بتوقيت دمشق) — افتراضي ٩ الصبح
# (هاد بس لتشغيل bot.py المحلي — على Render البث بيتحكم فيه رابط cron خارجي، شوف تحت)
DAILY_BROADCAST_HOUR=9
DAILY_BROADCAST_MINUTE=0

# --- هاد القسم بس لو ناشر البوت على Render (bot_webhook.py) ---

# نص عشوائي طويل وصعب التخمين (٢٠-٣٠ محرف/رقم إنجليزي) — بيحمي رابط تشغيل نشرة
# الأسعار اليومية من خدمة تنبيه خارجية. اخترعه إنت بنفسك، مثال: a8f3k29dLpQ7mXz1
BROADCAST_SECRET=REPLACE_ME

# ما تلمسه — Render بيعبيه لحاله تلقائياً بعد أول نشر
RENDER_EXTERNAL_URL=
